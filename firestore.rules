// Publish: Firebase Console → Build → Firestore Database → Rules → Paste → Publish
// Or (Firebase CLI installed): firebase deploy --only firestore:rules
// Project: sabanciinsight (.firebaserc)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /courses/{courseId} {
      allow read: if request.auth != null;
    }

    match /feedbacks/{feedbackId} {
      // Any logged-in user can read reviews (needed for course review pages)
      allow read: if request.auth != null;

      // Only the owner can update or delete their own feedback
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      // On create, enforce that createdBy matches the authenticated user
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
    }

    match /enrollment_verifications/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
    }

    match /course_ai_summaries/{courseId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
